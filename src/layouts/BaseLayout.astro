---
export interface Props {
  title?: string;
}
const { title = "Mi sitio" } = Astro.props;
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style>
      /* RESET */
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: 'Courier New', 'Segoe UI', monospace;
        min-height: 100vh;
        background-color: #0a0f1a;
        position: relative;
      }

      /* CIELO FUTURISTA (sin cambios) */
      .sky {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(ellipse at 30% 40%, #0b1120, #03050b);
        z-index: 0;
      }

      .stars {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: 
          radial-gradient(2px 2px at 10% 20%, #fff, rgba(0,0,0,0)),
          radial-gradient(1px 1px at 30% 45%, #0ff, rgba(0,0,0,0)),
          radial-gradient(3px 3px at 70% 80%, #fff, rgba(0,0,0,0)),
          radial-gradient(1px 1px at 85% 15%, #f0f, rgba(0,0,0,0)),
          radial-gradient(2px 2px at 45% 60%, #0ff, rgba(0,0,0,0));
        background-size: 200px 200px, 300px 300px, 250px 250px, 180px 180px, 400px 400px;
        background-repeat: no-repeat;
        opacity: 0.8;
        animation: starsTwinkle 4s infinite alternate;
        pointer-events: none;
        z-index: 1;
      }

      @keyframes starsTwinkle {
        0% { opacity: 0.4; }
        100% { opacity: 1; }
      }

      .moon {
        position: fixed;
        top: 12%;
        right: 8%;
        width: 80px;
        height: 80px;
        background: radial-gradient(circle, #0ff, #0066cc);
        border-radius: 50%;
        box-shadow: 0 0 40px cyan, 0 0 80px rgba(0,255,255,0.5);
        z-index: 2;
        animation: floatGlow 6s ease-in-out infinite;
      }

      @keyframes floatGlow {
        0%, 100% { transform: translateY(0px) scale(1); }
        50% { transform: translateY(-15px) scale(1.02); }
      }

      .neon-cloud {
        position: fixed;
        bottom: 5%;
        left: -20%;
        width: 80%;
        height: 200px;
        background: radial-gradient(ellipse, rgba(0,255,255,0.15), transparent);
        filter: blur(40px);
        animation: cloudDrift 20s linear infinite;
        z-index: 1;
        pointer-events: none;
      }

      .neon-cloud2 {
        top: 20%;
        left: auto;
        right: -30%;
        width: 70%;
        height: 250px;
        background: radial-gradient(ellipse, rgba(255,0,255,0.1), transparent);
        animation: cloudDrift2 25s linear infinite;
      }

      @keyframes cloudDrift {
        from { transform: translateX(0); }
        to { transform: translateX(150%); }
      }
      @keyframes cloudDrift2 {
        from { transform: translateX(0); }
        to { transform: translateX(-150%); }
      }

      /* LEDS */
      .led-grid {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-image: radial-gradient(circle at 20% 30%, #0ff 0.5px, transparent 1px);
        background-size: 50px 50px;
        opacity: 0.5;
        pointer-events: none;
        z-index: 2;
        animation: ledPulse 3s infinite alternate;
      }

      @keyframes ledPulse {
        0% { opacity: 0.2; background-position: 0% 0%; }
        100% { opacity: 0.7; background-position: 5% 5%; }
      }

      .led-rays {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: repeating-linear-gradient(180deg, 
          rgba(0, 255, 255, 0.08) 0px, 
          rgba(0, 255, 255, 0.08) 1px,
          transparent 1px,
          transparent 10px);
        pointer-events: none;
        z-index: 2;
      }

      /* ===== MAIN RESPONSIVO (evita solapamiento) ===== */
      main {
        position: relative;
        z-index: 10;
        max-width: 1200px;
        width: 90%;
        margin: 2rem auto;
        background: rgba(0, 0, 0, 0.55);
        backdrop-filter: blur(8px);
        border-radius: 24px;
        padding: 2rem;
        border: 1px solid rgba(0, 255, 255, 0.3);
        box-shadow: 0 0 30px rgba(0, 255, 255, 0.2);
        color: #e0e0ff;
        display: flex;
        justify-content: center;
        align-items: center;
        /* Eliminamos min-height fija para que no fuerce altura extra en móvil */
        min-height: auto;
      }

      /* RESPONSIVIDAD LAYOUT */
      @media (max-width: 768px) {
        main {
          width: 95%;
          margin: 1rem auto;
          padding: 1rem;
        }
        .moon {
          width: 50px;
          height: 50px;
          top: 5%;
          right: 5%;
        }
        .led-grid {
          background-size: 30px 30px;
        }
      }

      @media (max-width: 480px) {
        main {
          width: 98%;
          padding: 0.8rem;
          margin: 0.8rem auto;
        }
        .neon-cloud, .neon-cloud2 {
          display: none;  /* evita que nubes tapen el contenido */
        }
        .moon {
          width: 40px;
          height: 40px;
          top: 3%;
          right: 3%;
        }
      }
    </style>
  </head>
  <body>
    <div class="sky"></div>
    <div class="stars"></div>
    <div class="moon"></div>
    <div class="neon-cloud"></div>
    <div class="neon-cloud neon-cloud2"></div>
    <div class="led-grid"></div>
    <div class="led-rays"></div>

    <main>
      <slot />
    </main>
  </body>
</html>