---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Unir Conceptos - Investigación Operativa">
  <div class="match-card">
    <h2>🔗 UNIR CONCEPTOS</h2>
    <p class="subtitle">Haz clic en un término y luego en su definición</p>

    <!-- Estado y mensajes -->
    <div id="selectionStatus" class="selection-status">⚡ Ningún término seleccionado</div>
    <div id="messageArea" class="message-area info">Selecciona un término para empezar</div>
    <div id="remainingCounter" class="remaining-counter">Pares restantes: 6</div>

    <div class="game-area">
      <div class="column">
        <h3>TÉRMINOS</h3>
        <div id="termsList" class="list"></div>
      </div>
      <div class="column">
        <h3>DEFINICIONES</h3>
        <div id="defsList" class="list"></div>
      </div>
    </div>

    <button id="reiniciarBtn" class="reset-btn">🔄 REINICIAR Y MEZCLAR</button>

    <div style="text-align: center; margin-top: 2rem;">
      <a href="/dinamicaOperativa/" class="btn-neon">← VOLVER AL INICIO</a>
    </div>
  </div>

  <style>
    /* ========== ESTILOS FORZADOS CON !important ========== */
    .match-card {
      max-width: 1000px;
      margin: 0 auto;
      background: rgba(10,20,30,0.85) !important;
      backdrop-filter: blur(8px);
      border-radius: 24px;
      padding: 1.5rem;
      border: 1px solid #0ff !important;
      box-shadow: 0 0 20px rgba(0,255,255,0.3);
    }
    h2 { text-align: center; color: #0ff !important; font-family: monospace; text-shadow: 0 0 5px cyan; }
    .subtitle { text-align: center; color: #f0f !important; }

    .selection-status {
      background: #0a0f1a !important;
      border: 1px solid #0ff !important;
      border-radius: 60px;
      padding: 0.7rem;
      text-align: center;
      color: #0ff !important;
      margin-bottom: 0.8rem;
    }
    .message-area {
      background: #0a0f1a !important;
      border-left: 5px solid #0ff;
      padding: 0.8rem;
      margin-bottom: 0.8rem;
      border-radius: 12px;
      color: #0ff !important;
    }
    .remaining-counter {
      text-align: center;
      color: #f0f !important;
      font-weight: bold;
      margin-bottom: 1rem;
    }
    .game-area {
      display: flex;
      gap: 2rem;
      flex-wrap: wrap;
    }
    .column {
      flex: 1;
      min-width: 250px;
    }
    .column h3 {
      text-align: center;
      color: #f0f !important;
      border-bottom: 2px solid #0ff;
      display: inline-block;
      width: auto;
      margin: 0 auto 1rem;
    }
    .list {
      display: flex;
      flex-direction: column;
      gap: 0.8rem;
    }
    /* Estilos base de los botones - con !important para sobreescribir cualquier estilo global */
    .game-btn {
      background: #0a0f1a !important;
      border: 2px solid #0ff !important;
      border-radius: 20px !important;
      padding: 0.9rem !important;
      text-align: center !important;
      color: #0ff !important;
      font-family: monospace !important;
      font-size: 0.95rem !important;
      font-weight: bold !important;
      cursor: pointer;
      transition: all 0.2s ease;
      width: 100%;
      box-shadow: 0 0 5px rgba(0,255,255,0.3);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
    }
    /* Botón seleccionado */
    .game-btn.selected {
      background: #0ff !important;
      color: #000 !important;
      border-color: #fff !important;
      box-shadow: 0 0 20px #0ff !important;
      transform: scale(1.02);
    }
    .game-btn.selected::before {
      content: "✓";
      font-size: 1.4rem;
      font-weight: bold;
      color: #000;
      margin-right: 0.2rem;
    }
    /* Botón desaparecido (emparejado) */
    .game-btn.hidden {
      display: none !important;
    }
    /* Hover en botones no ocultos */
    .game-btn:hover:not(.hidden) {
      background: #1a2a3a !important;
      border-color: #fff !important;
      box-shadow: 0 0 12px #0ff !important;
    }
    .reset-btn {
      display: block;
      margin: 2rem auto 0;
      background: linear-gradient(135deg, #0ff, #0a8) !important;
      border: none;
      padding: 0.8rem 1.8rem;
      font-family: monospace;
      font-weight: bold;
      font-size: 1.1rem;
      border-radius: 60px;
      cursor: pointer;
      color: #000;
      box-shadow: 0 0 10px cyan;
    }
    .btn-neon {
      display: inline-block;
      background: transparent;
      border: 2px solid #0ff;
      color: #0ff;
      padding: 0.6rem 1.2rem;
      text-decoration: none;
      border-radius: 40px;
      transition: 0.3s;
    }
    .btn-neon:hover { background: #0ff; color: #000; }
    @media (max-width: 700px) {
      .game-area { flex-direction: column; }
      .game-btn { padding: 0.7rem; font-size: 0.8rem; }
    }
  </style>

  <script is:inline>
    // Datos
    const conceptos = [
      { term: "Modelo de Transporte", def: "Minimiza costo de distribución desde orígenes a destinos" },
      { term: "Método de Vogel (VAM)", def: "Usa penalizaciones para solución inicial cercana al óptimo" },
      { term: "Problema balanceado", def: "Oferta total = Demanda total" },
      { term: "Variables de decisión", def: "Cantidades enviadas desde cada origen a cada destino" },
      { term: "Función objetivo", def: "Minimizar latencia total en servidores gaming" },
      { term: "Latencia (RTT)", def: "Tiempo de ida y vuelta entre usuario y servidor" }
    ];

    let pendingTerms = [];      // índices de términos no emparejados
    let pendingDefs = [];       // índices de definiciones no emparejadas (orden mezclado)
    let selectedTerm = null;    // índice del término seleccionado
    let totalPairs = conceptos.length;

    const termsDiv = document.getElementById('termsList');
    const defsDiv = document.getElementById('defsList');
    const resetBtn = document.getElementById('reiniciarBtn');
    const msgDiv = document.getElementById('messageArea');
    const statusDiv = document.getElementById('selectionStatus');
    const counterSpan = document.getElementById('remainingCounter');

    function shuffle(arr) {
      for (let i = arr.length - 1; i > 0; i--) {
        const j = Math.floor(Math.random() * (i + 1));
        [arr[i], arr[j]] = [arr[j], arr[i]];
      }
      return arr;
    }

    function showMessage(text, type = 'info') {
      if (!msgDiv) return;
      msgDiv.textContent = text;
      msgDiv.className = `message-area ${type}`;
      if (type !== 'info') {
        setTimeout(() => {
          if (msgDiv.classList.contains(type)) msgDiv.className = 'message-area info';
        }, 2000);
      }
    }

    function updateUI() {
      if (!termsDiv || !defsDiv) return;
      // Términos
      termsDiv.innerHTML = '';
      pendingTerms.forEach(tIdx => {
        const btn = document.createElement('button');
        btn.className = 'game-btn';
        if (selectedTerm === tIdx) btn.classList.add('selected');
        btn.textContent = conceptos[tIdx].term;
        btn.addEventListener('click', () => onTermClick(tIdx));
        termsDiv.appendChild(btn);
      });
      // Definiciones
      defsDiv.innerHTML = '';
      pendingDefs.forEach(dIdx => {
        const btn = document.createElement('button');
        btn.className = 'game-btn';
        btn.textContent = conceptos[dIdx].def;
        btn.addEventListener('click', () => onDefClick(dIdx));
        defsDiv.appendChild(btn);
      });
      // Actualizar status y contador
      if (selectedTerm !== null) {
        statusDiv.innerHTML = `🔵 Término seleccionado: <strong>${conceptos[selectedTerm].term}</strong> → Ahora elige su definición`;
        statusDiv.style.background = '#0a3a4a';
      } else {
        statusDiv.innerHTML = `⚡ Ningún término seleccionado. Haz clic en un término.`;
        statusDiv.style.background = '#0a0f1a';
      }
      const remaining = pendingTerms.length;
      counterSpan.textContent = `Pares restantes: ${remaining}`;
      if (remaining === 0) counterSpan.style.color = '#0f0';
      else counterSpan.style.color = '#f0f';
    }

    function onTermClick(termIdx) {
      if (selectedTerm === termIdx) {
        selectedTerm = null;
        showMessage('Término deseleccionado.', 'info');
      } else {
        selectedTerm = termIdx;
        showMessage(`Término seleccionado: "${conceptos[termIdx].term}".`, 'info');
      }
      updateUI();
    }

    function onDefClick(defIdx) {
      if (selectedTerm === null) {
        showMessage('❌ Primero selecciona un término.', 'error');
        return;
      }
      if (selectedTerm === defIdx) {
        // Acierto
        pendingTerms = pendingTerms.filter(i => i !== selectedTerm);
        pendingDefs = pendingDefs.filter(i => i !== defIdx);
        selectedTerm = null;
        updateUI();
        showMessage(`✅ ¡Correcto! " ${conceptos[defIdx].term} " emparejado.`, 'success');
        if (pendingTerms.length === 0) {
          showMessage('🎉 ¡Felicidades! Completaste todos los pares.', 'success');
          statusDiv.innerHTML = '🏆 ¡Juego completado! Reinicia para jugar de nuevo.';
        }
      } else {
        showMessage(`❌ Incorrecto: "${conceptos[selectedTerm].term}" no corresponde a esa definición.`, 'error');
        selectedTerm = null;
        updateUI();
      }
    }

    function resetGame() {
      pendingTerms = Array.from({ length: totalPairs }, (_, i) => i);
      pendingDefs = Array.from({ length: totalPairs }, (_, i) => i);
      pendingDefs = shuffle(pendingDefs);
      selectedTerm = null;
      updateUI();
      showMessage('Juego reiniciado. Definiciones mezcladas.', 'info');
    }

    if (termsDiv && defsDiv && resetBtn) {
      resetBtn.addEventListener('click', resetGame);
      resetGame();
    } else {
      console.error('Elementos no encontrados');
    }
  </script>
</BaseLayout>