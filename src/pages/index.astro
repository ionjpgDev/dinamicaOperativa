---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Acceso al Servidor Gaming">
  <div class="terminal-card">
    <h2>📡 ACCESO AL SERVIDOR GAMING</h2>
    <p class="subtitle">Proyecto INF-243 - Investigación Operativa</p>

    <form id="registroForm" class="cyber-form">
      <div class="input-group">
        <label for="studentName">INGRESA TU NOMBRE:</label>
        <input type="text" id="studentName" name="nombre" required />
      </div>
      <button type="submit" id="btnConectar">CONECTAR AL SERVIDOR</button>
    </form>

    <!-- Dos botones para las dinámicas -->
    <div style="display: flex; flex-direction: column; gap: 0.8rem; margin-top: 1.5rem;">
      <a href="/dinamicaOperativa/trivia" class="btn-neon">📋 TRIVIA TÉCNICA</a>
      <a href="/dinamicaOperativa/unir" class="btn-neon">🔗 UNIR CONCEPTOS</a>
      <a href="/dinamicaOperativa/resumen" class="btn-neon">📄 RESUMEN DEL PROYECTO</a>
    </div>

    <div id="statusMessage" class="status-hidden"></div>
  </div>

  <style>
    /* ===== ESTILOS DEL FORMULARIO RESPONSIVOS ===== */
    .terminal-card {
      max-width: 500px;
      width: 100%;
      margin: 0 auto;
      background: rgba(10, 20, 30, 0.7);
      backdrop-filter: blur(4px);
      border-radius: 20px;
      padding: 2rem;
      border: 1px solid #0ff;
      box-shadow:
        0 0 20px rgba(0, 255, 255, 0.3),
        inset 0 0 10px rgba(0, 255, 255, 0.1);
      transition: all 0.3s ease;
      overflow-x: hidden;
    }

    h2 {
      font-family: "Courier New", monospace;
      font-size: 1.5rem;
      text-align: center;
      color: #0ff;
      text-shadow:
        0 0 5px #0ff,
        0 0 10px #0ff;
      letter-spacing: 2px;
      margin-bottom: 0.5rem;
      word-break: break-word;
    }

    .subtitle {
      text-align: center;
      color: #f0f;
      font-size: 0.8rem;
      margin-bottom: 2rem;
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .cyber-form {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .input-group {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    label {
      font-size: 0.8rem;
      font-weight: bold;
      letter-spacing: 1px;
      color: #0ff;
      text-transform: uppercase;
    }

    input {
      background: rgba(0, 0, 0, 0.6);
      border: 1px solid #0ff;
      padding: 0.8rem 1rem;
      border-radius: 8px;
      color: #0ff;
      font-family: monospace;
      font-size: 1rem;
      outline: none;
      transition: all 0.2s;
      width: 100%;
      box-sizing: border-box;
    }

    input:focus {
      border-color: #f0f;
      box-shadow: 0 0 12px #f0f;
      background: rgba(0, 0, 0, 0.8);
    }

    button {
      background: linear-gradient(135deg, #0ff, #0a8);
      border: none;
      padding: 0.8rem;
      font-family: "Courier New", monospace;
      font-weight: bold;
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 2px;
      color: #000;
      border-radius: 40px;
      cursor: pointer;
      transition: 0.2s;
      box-shadow: 0 0 10px #0ff;
      width: 100%;
    }

    button:hover {
      transform: scale(1.02);
      box-shadow:
        0 0 20px #0ff,
        0 0 30px #0ff;
      background: #0ff;
      color: #000;
    }

    button:disabled {
      opacity: 0.6;
      transform: none;
      cursor: not-allowed;
    }

    /* Estilo para los botones de navegación */
    .btn-neon {
      display: block;
      background: transparent;
      border: 2px solid #0ff;
      color: #0ff;
      padding: 0.7rem;
      font-family: "Courier New", monospace;
      font-weight: bold;
      text-transform: uppercase;
      text-decoration: none;
      border-radius: 40px;
      transition: 0.3s;
      text-align: center;
    }
    .btn-neon:hover {
      background: #0ff;
      color: #000;
      box-shadow: 0 0 20px #0ff;
      transform: scale(1.02);
    }

    .status-hidden {
      display: none;
    }

    .status-info,
    .status-success,
    .status-error {
      margin-top: 1.5rem;
      padding: 0.8rem;
      border-radius: 8px;
      text-align: center;
      font-family: monospace;
      font-size: 0.8rem;
      animation: fadeIn 0.3s;
      word-break: break-word;
    }

    .status-info {
      background: rgba(0, 255, 255, 0.2);
      border: 1px solid #0ff;
      color: #0ff;
    }

    .status-success {
      background: rgba(0, 255, 0, 0.2);
      border: 1px solid #0f0;
      color: #0f0;
      text-shadow: 0 0 2px #0f0;
    }

    .status-error {
      background: rgba(255, 0, 0, 0.2);
      border: 1px solid #f00;
      color: #f66;
    }

    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(-5px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    /* RESPONSIVIDAD */
    @media (max-width: 600px) {
      .terminal-card {
        padding: 1.2rem;
      }
      h2 {
        font-size: 1.2rem;
      }
      .subtitle {
        font-size: 0.7rem;
        margin-bottom: 1.5rem;
      }
      button {
        font-size: 0.8rem;
        padding: 0.7rem;
      }
      input {
        padding: 0.7rem;
        font-size: 0.9rem;
      }
    }

    @media (max-width: 480px) {
      .terminal-card {
        padding: 1rem;
      }
      h2 {
        font-size: 1rem;
      }
      .cyber-form {
        gap: 1rem;
      }
    }
  </style>

  <script is:inline>
    const GOOGLE_SCRIPT_URL =
      "https://script.google.com/macros/s/AKfycbzjROaxyiTTd80VoLvfTEvZt6fsSIdJt9iZ-nQM6RI68VmWzFVx1Q86nNGVkCcKGvH2QA/exec";

    const form = document.getElementById("registroForm");
    const statusDiv = document.getElementById("statusMessage");
    const btnSubmit = document.getElementById("btnConectar");

    if (form && btnSubmit && statusDiv) {
      form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const formData = new FormData(form);
        const nombreInput = formData.get("nombre");

        btnSubmit.disabled = true;
        btnSubmit.innerText = "MIDIENDO LATENCIA... ⏳";

        statusDiv.className = "status-info";
        statusDiv.innerText = "Calculando RTT...";
        statusDiv.style.display = "block";

        const startTime = performance.now();

        try {
          await fetch(GOOGLE_SCRIPT_URL, {
            method: "POST",
            mode: "no-cors",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ nombre: nombreInput }),
          });

          const rtt = Math.round(performance.now() - startTime);

          statusDiv.className = "status-success";
          statusDiv.innerHTML = `¡Hola, ${nombreInput}! Tu latencia es de ${rtt} ms. 🚀`;

          form.reset();
        } catch (error) {
          console.error(error);
          statusDiv.className = "status-error";
          statusDiv.innerHTML = "Error al medir la latencia. Intenta de nuevo.";
        } finally {
          btnSubmit.disabled = false;
          btnSubmit.innerText = "CONECTAR AL SERVIDOR";
        }
      });
    }
  </script>
</BaseLayout>