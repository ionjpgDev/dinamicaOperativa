---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Trivia - Investigación Operativa">
  <div class="trivia-card">
    <h2>📋 TRIVIA TÉCNICA</h2>
    <p class="subtitle">Responde las 10 preguntas de Investigación Operativa</p>

    <form id="triviaForm">
      <!-- Pregunta 1 -->
      <div class="question">
        <p><strong>1.</strong> ¿Qué método de solución inicial del modelo de transporte suele dar la mejor aproximación al óptimo?</p>
        <label><input type="radio" name="q1" value="A"> Método de la Esquina Noroeste</label>
        <label><input type="radio" name="q1" value="B"> Método del Costo Mínimo</label>
        <label><input type="radio" name="q1" value="C"> Método de Aproximación de Vogel (VAM)</label>
        <label><input type="radio" name="q1" value="D"> Método de la Ruta Crítica</label>
      </div>
      <!-- Pregunta 2 -->
      <div class="question">
        <p><strong>2.</strong> En un problema de transporte balanceado, la suma de ofertas es __________ a la suma de demandas.</p>
        <label><input type="radio" name="q2" value="A"> Mayor</label>
        <label><input type="radio" name="q2" value="B"> Menor</label>
        <label><input type="radio" name="q2" value="C"> Igual</label>
        <label><input type="radio" name="q2" value="D"> No relacionada</label>
      </div>
      <!-- Pregunta 3 -->
      <div class="question">
        <p><strong>3.</strong> ¿Qué representa la variable "x_ij" en el modelo de transporte?</p>
        <label><input type="radio" name="q3" value="A"> La latencia entre origen i y destino j</label>
        <label><input type="radio" name="q3" value="B"> La cantidad enviada desde i hacia j</label>
        <label><input type="radio" name="q3" value="C"> El costo unitario de transporte</label>
        <label><input type="radio" name="q3" value="D"> La capacidad del servidor i</label>
      </div>
      <!-- Pregunta 4 -->
      <div class="question">
        <p><strong>4.</strong> ¿Cuál es el objetivo principal del modelo de transporte aplicado a servidores gaming?</p>
        <label><input type="radio" name="q4" value="A"> Maximizar el número de jugadores</label>
        <label><input type="radio" name="q4" value="B"> Minimizar la latencia total</label>
        <label><input type="radio" name="q4" value="C"> Minimizar el costo de servidores</label>
        <label><input type="radio" name="q4" value="D"> Maximizar el ancho de banda</label>
      </div>
      <!-- Pregunta 5 -->
      <div class="question">
        <p><strong>5.</strong> Con 3 orígenes y 4 destinos, ¿cuántas variables de decisión hay en un problema de transporte?</p>
        <label><input type="radio" name="q5" value="A"> 7</label>
        <label><input type="radio" name="q5" value="B"> 12</label>
        <label><input type="radio" name="q5" value="C"> 8</label>
        <label><input type="radio" name="q5" value="D"> 3</label>
      </div>
      <!-- Pregunta 6 -->
      <div class="question">
        <p><strong>6.</strong> En el método de la esquina noroeste, ¿cómo se selecciona la celda a la que se asigna la primera cantidad?</p>
        <label><input type="radio" name="q6" value="A"> La de menor costo</label>
        <label><input type="radio" name="q6" value="B"> La de mayor costo</label>
        <label><input type="radio" name="q6" value="C"> La esquina superior izquierda</label>
        <label><input type="radio" name="q6" value="D"> La esquina inferior derecha</label>
      </div>
      <!-- Pregunta 7 -->
      <div class="question">
        <p><strong>7.</strong> ¿Qué técnica se utiliza para mejorar una solución inicial en el modelo de transporte?</p>
        <label><input type="radio" name="q7" value="A"> Método simplex</label>
        <label><input type="radio" name="q7" value="B"> Método de las penalizaciones</label>
        <label><input type="radio" name="q7" value="C"> Algoritmo de Stepping Stone (saltos)</label>
        <label><input type="radio" name="q7" value="D"> Algoritmo de Dijkstra</label>
      </div>
      <!-- Pregunta 8 -->
      <div class="question">
        <p><strong>8.</strong> Si en una solución de transporte el número de asignaciones básicas es menor que (m+n-1), se dice que la solución es:</p>
        <label><input type="radio" name="q8" value="A"> Degenerada</label>
        <label><input type="radio" name="q8" value="B"> No factible</label>
        <label><input type="radio" name="q8" value="C"> Óptima</label>
        <label><input type="radio" name="q8" value="D"> Ilimitada</label>
      </div>
      <!-- Pregunta 9 -->
      <div class="question">
        <p><strong>9.</strong> ¿Qué tipo de problema resuelve la teoría de colas en el contexto de servidores gaming?</p>
        <label><input type="radio" name="q9" value="A"> Asignación óptima de recursos</label>
        <label><input type="radio" name="q9" value="B"> Minimización del tiempo de espera y congestión</label>
        <label><input type="radio" name="q9" value="C"> Maximización de la demanda</label>
        <label><input type="radio" name="q9" value="D"> Reducción de costos fijos</label>
      </div>
      <!-- Pregunta 10 -->
      <div class="question">
        <p><strong>10.</strong> ¿Cuál de los siguientes es un método de solución para problemas de flujo de redes?</p>
        <label><input type="radio" name="q10" value="A"> Método de la ruta crítica (CPM)</label>
        <label><input type="radio" name="q10" value="B"> Algoritmo de Ford-Fulkerson</label>
        <label><input type="radio" name="q10" value="C"> Método de la Gran M</label>
        <label><input type="radio" name="q10" value="D"> Método de Branch and Bound</label>
      </div>

      <button type="button" id="calificarBtn">✅ CALIFICAR</button>
      <div id="resultado" class="result-hidden"></div>
    </form>

    <div style="text-align: center; margin-top: 2rem;">
      <a href="/dinamicaOperativa/" class="btn-neon">← VOLVER</a>
    </div>
  </div>

  <style>
    .trivia-card {
      max-width: 700px;
      margin: 0 auto;
      background: rgba(10,20,30,0.75);
      backdrop-filter: blur(8px);
      border-radius: 24px;
      padding: 2rem;
      border: 1px solid #0ff;
    }
    h2 { text-align: center; color: #0ff; font-family: monospace; }
    .subtitle { text-align: center; color: #f0f; margin-bottom: 1.5rem; }
    .question {
      background: rgba(0,0,0,0.4);
      border-left: 4px solid #0ff;
      padding: 1rem;
      margin-bottom: 1.5rem;
      border-radius: 12px;
    }
    .question p { color: #e0e0ff; font-weight: bold; margin-bottom: 0.5rem; }
    label { display: block; margin: 0.3rem 0; color: #0ff; cursor: pointer; }
    input { margin-right: 0.5rem; }
    button {
      background: linear-gradient(135deg, #0ff, #0a8);
      border: none;
      width: 100%;
      padding: 0.8rem;
      font-family: monospace;
      font-weight: bold;
      border-radius: 40px;
      cursor: pointer;
    }
    .result-hidden { display: none; margin-top: 1rem; padding: 1rem; border-radius: 12px; text-align: center; }
    .result-success { display: block; background: rgba(0,255,0,0.2); border: 1px solid #0f0; color: #0f0; }
    .result-error { display: block; background: rgba(255,0,0,0.2); border: 1px solid #f00; color: #f66; }
    .btn-neon {
      display: inline-block;
      background: transparent;
      border: 2px solid #0ff;
      color: #0ff;
      padding: 0.6rem 1.2rem;
      text-decoration: none;
      border-radius: 40px;
    }
    .btn-neon:hover { background: #0ff; color: #000; }
  </style>

  <script is:inline>
    const btn = document.getElementById('calificarBtn');
    const resultado = document.getElementById('resultado');
    const correctas = {
      q1: 'C',   // Vogel
      q2: 'C',   // Igual
      q3: 'B',   // Cantidad enviada
      q4: 'B',   // Minimizar latencia
      q5: 'B',   // 12 variables (3*4)
      q6: 'C',   // Esquina superior izquierda
      q7: 'C',   // Stepping Stone
      q8: 'A',   // Degenerada
      q9: 'B',   // Minimizar tiempo de espera y congestión
      q10: 'B'   // Ford-Fulkerson
    };
    
    if (btn && resultado) {
      btn.addEventListener('click', () => {
        let aciertos = 0;
        for (const [preg, resp] of Object.entries(correctas)) {
          const selec = document.querySelector(`input[name="${preg}"]:checked`);
          if (selec && selec.value === resp) aciertos++;
        }
        let mensaje = '';
        if (aciertos === 10) mensaje = '🏆 ¡Perfecto! Eres un experto en Investigación Operativa.';
        else if (aciertos >= 7) mensaje = '✅ Muy bien. Tienes un buen dominio de la materia.';
        else if (aciertos >= 5) mensaje = '📚 Puedes mejorar. Revisa los conceptos del modelo de transporte y redes.';
        else mensaje = '📖 Sigue practicando. Te sugerimos repasar la teoría básica de IO.';
        resultado.className = 'result-success';
        resultado.innerHTML = `🎯 Aciertos: ${aciertos}/10. ${mensaje}`;
      });
    }
  </script>
</BaseLayout>